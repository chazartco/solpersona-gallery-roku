' Video (SPEC §6.3).
'
' One Video node plays the films: Roku decodes one video at a time. It is
' moved into the front layer's video slot, over the film's still, once the
' layer's transition has finished — the video plane sits under the graphics
' and does not fade with them, so the still fades and the film then takes
' over (and stops before the next fade begins).
'
' What a film is comes from a HEAD request made when its entry is created
' (Cache.ensureEntry): many media URLs have no extension, and a WebM handed
' to the Video node as "mp4" fails. MP4 (H.264/AAC) plays; WebM/VP9 plays
' only where this Roku says it decodes VP9, else the still shows for the
' slot. A film that errors tries its next copy (fallbacks), then its still.
' Muted unless videoSound. A screen joining mid-slot starts at offsetMs mod
' duration; whole plays loop until the slot ends; an estimated slot lets the
' play finish (Planner.shouldHoldVideo).
'
' The screensaver: the app does not hold it off. A playing film keeps the
' screen awake by itself; between films the Roku's own setting decides, so a
' gallery wall sets Settings → Theme → Screensavers → Change wait time →
' Disabled (README, certification rule 4.5).

sub initFilm()
    m.film = m.top.FindNode("artVideo")
    m.film.ObserveField("state", "onFilmState")
    m.filmLayer = invalid
    m.filmLog = []
    m.filmStartedAt = 0
    info = CreateObject("roDeviceInfo")
    m.vp9 = false
    vp9 = info.CanDecodeVideo({ Codec: "vp9", Container: "mkv" })
    if Util.isAA(vp9) and vp9.result = true then m.vp9 = true
end sub

sub onFilmProbed(r as object, ctx as object)
    e = m.cache[ctx.key]
    if e = invalid then return
    status = Int(Util.num(r.status))
    if status = 401 or status = 403 or status = 404 or status = 410 then
        ' The host refuses it outright: do not make the Video node find out
        ' (and the wall wait) — go straight to the next copy.
        noteFilm(e.id + " refused " + status.ToStr() + " " + Util.urlSummary(ctx.url))
        dropFilmUrl(e, ctx.url)
        return
    end if
    if r.ok <> true then return
    t = Util.strOr(r.contentType, "")
    e.filmTypes[ctx.url] = t
    e.filmBytes[ctx.url] = Util.num(r.bytes)
    unplayable = Left(t, 6) = "image/" or Left(t, 5) = "text/" or ((Instr(1, t, "webm") > 0 or Instr(1, t, "ogg") > 0) and not m.vp9)
    if not unplayable then return
    ' Not a film this Roku can play: drop that copy before anyone tries it.
    noteFilm(e.id + " skip " + t)
    dropFilmUrl(e, ctx.url)
end sub

' Removes one copy of a film, keeping the one playing (if any) in place.
sub dropFilmUrl(e as object, url as string)
    playing = invalid
    if e.filmIndex < e.filmUrls.Count() then playing = e.filmUrls[e.filmIndex]
    kept = []
    for each u in e.filmUrls
        if u <> url then kept.Push(u)
    end for
    e.filmUrls = kept
    e.filmIndex = 0
    if playing <> invalid and playing <> url then
        for i = 0 to kept.Count() - 1
            if kept[i] = playing then e.filmIndex = i
        end for
    end if
    if kept.Count() = 0 then e.stillFallback = true
end sub

' The Video node's streamFormat for a film, from what the server said it is.
function streamFormatFor(e as object, url as string) as string
    t = e.filmTypes[url]
    if t <> invalid then
        if Instr(1, t, "mp4") > 0 or Instr(1, t, "quicktime") > 0 or Instr(1, t, "m4v") > 0 then return "mp4"
        if Instr(1, t, "webm") > 0 or Instr(1, t, "matroska") > 0 then return "mkv"
        if Instr(1, t, "mpegurl") > 0 then return "hls"
        if Instr(1, t, "dash") > 0 then return "dash"
    end if
    return MediaPick.streamFormatOf(url)
end function

sub startFilm(idx as integer)
    L = m.layers[idx]
    e = m.cache[L.entryKey]
    if e = invalid or not L.isVideo then return
    if L.target <> invalid and (L.target.paused or m.blackout) then return
    if e.filmIndex >= e.filmUrls.Count() then
        L.isVideo = false
        return
    end if
    source = e.filmUrls[e.filmIndex]
    url = source
    kept = keptPathFor(source)
    if kept <> invalid and not e.keptFilmFailed then url = kept

    stopFilmQuietly()
    parent = m.film.GetParent()
    if parent <> invalid then parent.RemoveChild(m.film)
    L.node.videoSlot.AppendChild(m.film)
    r = L.node.pieceRect
    if L.settings.fit = "FILL" or r = invalid then r = { x: 0, y: 0, w: Ui.SCREEN_W, h: Ui.SCREEN_H }
    m.film.translation = [r.x, r.y]
    m.film.width = r.w
    m.film.height = r.h

    content = CreateObject("roSGNode", "ContentNode")
    content.url = url
    content.streamFormat = streamFormatFor(e, source)
    ' In step: a screen joining mid-slot starts the film where the others are.
    if Util.isNumber(e.durationMs) and e.durationMs > 0 and L.target <> invalid then
        at = (L.target.offsetMs - Util.floor(L.target.offsetMs / e.durationMs) * e.durationMs) / 1000.0
        if at < e.durationMs / 1000.0 - 0.25 then content.PlayStart = Int(at)
    end if
    m.film.content = content
    m.film.mute = not L.settings.videoSound
    m.film.visible = true
    m.film.control = "play"
    m.filmLayer = idx
    m.filmStartedAt = monoNow()
    L.filmStarted = true
    L.filmUrl = url
    L.playEnded = false
    noteFilm(e.id + " play " + content.streamFormat + " " + Util.urlSummary(source))
end sub

sub stopFilm()
    stopFilmQuietly()
end sub

sub stopFilmQuietly()
    if m.filmLayer = invalid then return
    L = m.layers[m.filmLayer]
    L.filmStarted = false
    m.filmLayer = invalid
    m.film.control = "stop"
    m.film.visible = false
    parent = m.film.GetParent()
    if parent <> invalid then parent.RemoveChild(m.film)
    m.top.AppendChild(m.film)
end sub

sub onFilmState(event as object)
    if m.filmLayer = invalid then return
    L = m.layers[m.filmLayer]
    e = m.cache[L.entryKey]
    state = event.GetData()
    noteFilm(Util.strOr(L.itemId, "?") + " " + state + " " + Str(Int(Util.num(m.film.position))).Trim() + "s")
    if state = "playing" then
        d = m.film.duration
        if Util.isNumber(d) and d > 0 then
            ' The first time a film's length is known: report it (SPEC §6.4).
            SyncLogic.reportDuration(m.S, L.itemId, d)
            L.durationMs = d * 1000
            if e <> invalid then e.durationMs = d * 1000
        end if
    else if state = "finished" then
        onFilmEnded(L)
    else if state = "error" then
        ' Roku's own words, for the debug panel and the dashboard (state.error).
        why = Util.strOr(m.film.errorMsg, "")
        if Util.str(m.film.errorStr) <> invalid then why = why + " (" + m.film.errorStr + ")"
        why = why + " code " + Str(Util.num(m.film.errorCode)).Trim()
        noteFilm(Util.strOr(L.itemId, "?") + " ERROR " + why)
        noteFilm("  url " + Util.urlSummary(L.filmUrl))
        idx = m.filmLayer
        if e <> invalid then
            e.filmError = why
            if L.filmUrl <> e.filmUrls[e.filmIndex] and not e.keptFilmFailed then
                ' The stick's copy would not play from local storage here: stream it.
                e.keptFilmFailed = true
                stopFilmQuietly()
                startFilm(idx)
                return
            end if
            if e.filmIndex + 1 < e.filmUrls.Count() then
                ' The next copy may live on a friendlier host or in a friendlier format.
                e.filmIndex += 1
                stopFilmQuietly()
                startFilm(idx)
                return
            end if
            ' A film this Roku cannot play: its still stays up for the slot.
            e.stillFallback = true
        end if
        m.S.lastError = Left("could not play " + Util.strOr(L.itemId, "?") + ": " + why, 200)
        L.isVideo = false
        stopFilm()
    end if
end sub

sub onFilmEnded(L as object)
    t = m.target
    if t <> invalid and t.key = L.key and not t.paused and not m.blackout and m.layers[m.front].node.IsSameNode(L.node) then
        ' The slot is not over: another whole play.
        m.film.control = "replay"
    else
        ' The slot is over (or we held it for this): now the next piece may come.
        L.playEnded = true
        tick()
    end if
end sub

' Keeps a playing film where the clock says it should be (screens in step).
sub syncPlayback(L as object, target as object, nowLocal as double)
    L.target = target
    L.estimated = target.estimated
    L.holdSince = 0
    if not L.isVideo then return
    if not L.filmStarted then
        if not target.paused and not m.blackout and m.transition = invalid then startFilm(m.front)
        return
    end if
    if target.paused or m.blackout then
        if m.film.state = "playing" then m.film.control = "pause"
        return
    end if
    if m.film.state = "paused" and not L.playEnded then m.film.control = "resume"
    d = m.film.duration
    ' Every seek makes a Roku rebuffer a streamed file, and a film seeked over
    ' and over while it is still filling its buffer stalls and errors. So the
    ' film is left alone for its first 20 s, and then corrected only when it
    ' is more than 3 s out of step, at most once a minute.
    if L.lastSeek = 0 then L.lastSeek = m.filmStartedAt
    if not target.estimated and Util.isNumber(d) and d > 10 and nowLocal - L.lastSeek > 60000 and nowLocal - m.filmStartedAt > 20000 and m.film.state = "playing" then
        dms = d * 1000
        expected = (target.offsetMs - Util.floor(target.offsetMs / dms) * dms) / 1000.0
        if expected > 2 and expected < d - 3 and Abs(m.film.position - expected) > 3 then
            noteFilm(Util.strOr(L.itemId, "?") + " seek " + Str(Int(m.film.position)).Trim() + "→" + Str(Int(expected)).Trim())
            m.film.seek = expected
            L.lastSeek = nowLocal
        end if
    end if
end sub

sub pauseFilmForBlackout()
    if m.filmLayer <> invalid and m.film.state = "playing" then m.film.control = "pause"
end sub

' The last few film events, for the debug panel.
sub noteFilm(text as string)
    m.filmLog.Unshift(Util.localHhmmss(Util.wallMs()) + " " + text)
    if m.filmLog.Count() > 8 then m.filmLog.Pop()
end sub
